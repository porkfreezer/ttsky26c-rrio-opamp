.param ps_w=0.42 ps_l=3 ns2_w=0.42 ns2_l=0.5 ns_w=0.5 ns_l=0.15 nsp_w=0.5 nsp_l=0.5 psp_w=0.5 psp_l=0.5
.options savecurrents
.save all
.save ref
.save inm inp
.control
let run=1
*dowhile run < 128
 dc temp -40 125 15 v1 1.6 2 0.2
 plot ref
* write bgr.raw
* set appendwrite
* reset
* let run=run+1
*end
.endc
"}
