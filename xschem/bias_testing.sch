C {code.sym} -325 -335 0 0 {name=sim only_toplevel=true value="
.param pl_w=2 pl_l=2 pnf=1 n_w=2 n_l=2 K=4 r_l=6.1
.param ns_w=0.5 ns_l=0.5 ns2_w=0.5 ns2_l=0.15 ps_l=3 ps_w=0.42 c_l=4
.save i(vmeas)
.options savecurrents
.save all
.control
let run = 0
dowhile run < 128
  dc TEMP -40 125 15 v1 1.6 2 0.2
*  plot i(vmeas)
  write reference.raw
  set appendwrite
  let run = run+1
  reset
end
.endc
"}
